# Machine-local Claude Code config (permissions, project slash commands).
# Nothing here ships: the bridge's own MCP prompt (/mcp__clenby__handoff) is
# the single supported entry point, and a repo-only duplicate would reach
# contributors but never users, then drift from the prompt it copies.
.claude/

# Dependencies & build output
node_modules/
.output/
.wxt/
chrome-extension-build/
*.zip
*.log
stats.html
.DS_Store

# Internal — working docs, roadmap, strategy, design artifacts, private data.
# Never publish; keeps the public repo to just the product.
internal/
CLAUDE.md

# Website — its own separate repo, kept here for convenience only.
# Never tracked by the extension repo.
website/
